# Copy to .env and fill in.  .env is gitignored — never commit real secrets.

# ---- Keycloak (required: api.py refuses to start without SECRET + PASSWORD) ----
KEYCLOAK_AUTH_SERVER_URL=https://lifewatch.lab.uvalight.net/auth
KEYCLOAK_REALM=vre
KEYCLOAK_CLIENT_ID=lter-life-catalogue-harvester
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_USERNAME=harvester-service-account
KEYCLOAK_PASSWORD=

# ---- GeoNetwork target catalogue (used by "Push to GeoNetwork") ----
GEONETWORK_BASE_URL=https://lter-life-catalogue.qcdis.org/geonetwork
GEONETWORK_PORTAL=srv
GEONETWORK_GROUP_ID=7
GN_IMPORT_BATCH_SIZE=15

# ---- LLM metadata harvester service ----
# When the harvester runs ON the same VM as the LLM service, use localhost.
LLM_HARVESTER_BASE_URL=http://127.0.0.1:8010
LLM_HARVESTER_API_KEY=
LLM_HARVESTER_MODEL=surf-default-text-large
LLM_HARVESTER_TIMEOUT_SEC=120
LLM_HARVESTER_POLL_INTERVAL_SEC=2
